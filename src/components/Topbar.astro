---
interface Props {
  user?: import("@supabase/supabase-js").User | null;
}

const { user = Astro.locals.user } = Astro.props;
---

<div class="border-border bg-card mb-4 flex items-center justify-between rounded-lg border px-4 py-2 text-sm shadow-sm">
  {
    user ? (
      <>
        <span class="text-muted-foreground">{user.email}</span>
        <div class="flex items-center gap-3">
          <a href="/dashboard" class="text-muted-foreground hover:text-foreground transition-colors hover:underline">
            Dashboard
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-muted-foreground hover:text-foreground transition-colors hover:underline">
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-muted-foreground">Not signed in</span>
        <div class="flex gap-3">
          <a href="/auth/signin" class="text-primary transition-colors hover:underline">
            Sign in
          </a>
          <a href="/auth/signup" class="text-primary transition-colors hover:underline">
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
