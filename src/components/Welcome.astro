---
import Topbar from "@/components/Topbar.astro";
---

<Topbar />

<div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-20 text-center sm:py-28">
  <h1 class="text-foreground mb-4 text-4xl font-semibold sm:text-5xl">OZC-cal</h1>
  <p class="text-muted-foreground mb-8 max-w-2xl text-lg">
    Calculate building heat demand from floor-plan PDFs. Define climate zone, assemblies, room zones, and run OZC
    calculations — without heavyweight CAD software.
  </p>
  <div class="flex flex-col gap-3 sm:flex-row">
    <a
      href="/auth/signin"
      class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center justify-center rounded-lg px-6 py-3 text-base font-medium transition-colors"
    >
      Sign In
    </a>
    <a
      href="/auth/signup"
      class="border-border bg-background text-foreground hover:bg-accent inline-flex items-center justify-center rounded-lg border px-6 py-3 text-base font-medium transition-colors"
    >
      Sign Up
    </a>
  </div>
</div>

<div class="mx-auto grid max-w-4xl grid-cols-1 gap-4 px-4 pb-16 sm:grid-cols-3">
  <div class="border-border bg-card rounded-lg border p-6 shadow-sm">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-primary mb-3"
    >
      <path d="M12 2v2"></path>
      <path d="M12 20v2"></path>
      <path d="m4.93 4.93 1.41 1.41"></path>
      <path d="m17.66 17.66 1.41 1.41"></path>
      <path d="M2 12h2"></path>
      <path d="M20 12h2"></path>
      <path d="m6.34 17.66-1.41 1.41"></path>
      <path d="m19.07 4.93-1.41 1.41"></path>
      <circle cx="12" cy="12" r="4"></circle>
    </svg>
    <h3 class="text-foreground mb-2 text-lg font-semibold">Heat demand (OZC)</h3>
    <p class="text-muted-foreground text-sm leading-relaxed">
      Set climate zone and external temperature, define building assemblies, and run heat loss calculations.
    </p>
  </div>

  <div class="border-border bg-card rounded-lg border p-6 shadow-sm">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-primary mb-3"
    >
      <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
      <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
      <path d="M10 13h4"></path>
      <path d="M10 17h4"></path>
      <path d="M10 9h1"></path>
    </svg>
    <h3 class="text-foreground mb-2 text-lg font-semibold">Floor plan editor</h3>
    <p class="text-muted-foreground text-sm leading-relaxed">
      Import a PDF plan, draw orthogonal walls with assemblies, and close room zones with internal temperatures.
    </p>
  </div>

  <div class="border-border bg-card rounded-lg border p-6 shadow-sm">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-primary mb-3"
    >
      <path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"></path>
      <path d="m3 9 2.45-4.9A2 2 0 0 1 7.24 3h9.52a2 2 0 0 1 1.8 1.1L21 9"></path>
      <path d="M12 3v6"></path>
    </svg>
    <h3 class="text-foreground mb-2 text-lg font-semibold">Ventilation & projects</h3>
    <p class="text-muted-foreground text-sm leading-relaxed">
      Configure gravity ventilation per room, save your project, and return to continue where you left off.
    </p>
  </div>
</div>
