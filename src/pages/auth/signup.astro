---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import AppShell from "@/components/AppShell.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign up">
  <AppShell class="flex items-center justify-center">
    <div class="border-border bg-card w-full max-w-sm rounded-lg border p-8 shadow-sm">
      <h1 class="text-foreground mb-6 text-center text-2xl font-semibold">Sign up</h1>
      <SignUpForm serverError={error} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Already have an account? <a href="/auth/signin" class="text-primary hover:underline">Sign in</a>
      </p>
    </div>
  </AppShell>
</Layout>
