---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import AppShell from "@/components/AppShell.astro";
import Topbar from "@/components/Topbar.astro";
import CreateProjectDialog from "@/components/projects/CreateProjectDialog";
import { createClient } from "@/lib/supabase";
import { listProjects } from "@/lib/services/projects";
import type { Project } from "@/types";

const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
  dateStyle: "medium",
  timeStyle: "short",
});

let projects: Project[] = [];
let listError: string | null = null;
const supabase = createClient(Astro.request.headers, Astro.cookies);

if (supabase) {
  try {
    projects = await listProjects(supabase);
  } catch {
    listError = "Could not load projects. Please try again.";
  }
}
---

<Layout title="Dashboard">
  <AppShell>
    <Topbar user={user} />

    <div class="mx-auto mt-8 max-w-3xl">
      {
        error && (
          <div
            class="border-destructive/30 bg-destructive/10 text-destructive mb-6 rounded-lg border px-4 py-3 text-sm"
            role="alert"
          >
            {error}
          </div>
        )
      }

      {
        listError && (
          <div
            class="border-destructive/30 bg-destructive/10 text-destructive mb-6 rounded-lg border px-4 py-3 text-sm"
            role="alert"
          >
            {listError}
          </div>
        )
      }

      <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h1 class="text-foreground text-3xl font-semibold">Your projects</h1>
          <p class="text-muted-foreground mt-1 text-sm">
            Signed in as <span class="text-foreground">{user?.email}</span>
          </p>
        </div>
        <CreateProjectDialog client:load />
      </div>

      {
        projects.length === 0 ? (
          <div class="border-border bg-card rounded-lg border p-10 text-center shadow-sm">
            <p class="text-foreground text-lg">No projects yet</p>
            <p class="text-muted-foreground mt-2 text-sm">
              Create your first project to start defining building parameters and floor plans.
            </p>
            <div class="mt-6 flex justify-center">
              <CreateProjectDialog client:load />
            </div>
          </div>
        ) : (
          <ul class="space-y-3">
            {projects.map((project) => (
              <li>
                <a
                  href={`/projects/${project.id}`}
                  class="border-border bg-card hover:border-primary/40 hover:bg-accent/50 block rounded-lg border px-5 py-4 shadow-sm transition-colors"
                >
                  <div class="flex items-center justify-between gap-4">
                    <span class="text-foreground font-medium">{project.name}</span>
                    <span class="text-muted-foreground shrink-0 text-xs">
                      Updated {dateFormatter.format(new Date(project.updated_at))}
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </AppShell>
</Layout>
