---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import AssemblyCatalog from "@/components/projects/AssemblyCatalog";
import OzcCalculationPanel from "@/components/projects/OzcCalculationPanel";
import { CLIMATE_ZONES, getDefaultTempForZone } from "@/lib/climate/poland-zones";
import { resolveProjectDetail } from "@/lib/projects/resolve-project-detail";
import { STOREY_HEIGHT_DEFAULT_M } from "@/lib/validation/climate";
import { ASSEMBLY_CATEGORIES, type ClimateZoneId } from "@/types";

const { user } = Astro.locals;

const result = await resolveProjectDetail(Astro.params.id, Astro.request.headers, Astro.cookies);

if (result.status === "redirect") {
  return Astro.redirect(result.location);
}

const { project, assemblies, hasClimate, hasFloorPlan } = result;

const editorReady = hasClimate && hasFloorPlan && assemblies.length > 0;
const editorUrl = `/projects/${project.id}/editor`;

const error = Astro.url.searchParams.get("error");
const saved = Astro.url.searchParams.get("saved");

const savedMessages: Record<string, string> = {
  climate: "Climate settings saved.",
  assembly: "Assembly saved.",
  "floor-plan": "Floor plan uploaded.",
  "floor-plan-removed": "Floor plan removed.",
};

const floorPlanApiUrl = `/api/projects/${project.id}/floor-plan`;
const savedMessage = saved && saved in savedMessages ? savedMessages[saved] : null;

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
  dateStyle: "medium",
  timeStyle: "short",
});

const selectedZone: ClimateZoneId = project.climate_zone ?? "I";
const tempValue = project.external_design_temp_c ?? getDefaultTempForZone(selectedZone);
const storeyHeightValue = project.storey_height_m ?? STOREY_HEIGHT_DEFAULT_M;
const zoneDefaultsJson = JSON.stringify(Object.fromEntries(CLIMATE_ZONES.map((zone) => [zone.id, zone.defaultTempC])));
---

<Layout title={project.name}>
  <div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
    <div
      class="pointer-events-none absolute top-1/4 -left-24 h-[350px] w-[350px] rounded-full bg-purple-500/20 blur-[120px]"
    >
    </div>
    <div
      class="pointer-events-none absolute top-2/3 -right-16 h-[250px] w-[250px] rounded-full bg-blue-500/15 blur-[100px]"
    >
    </div>

    <div class="relative z-10 p-4 sm:p-8">
      <Topbar user={user} />

      <div class="mx-auto mt-8 max-w-3xl">
        <a href="/dashboard" class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          ← Back to projects
        </a>

        {
          error && (
            <div
              class="mt-4 rounded-lg border border-red-400/40 bg-red-500/10 px-4 py-3 text-sm text-red-200"
              role="alert"
            >
              {error}
            </div>
          )
        }

        {
          savedMessage && (
            <div
              class="mt-4 rounded-lg border border-emerald-400/40 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200"
              role="status"
            >
              {savedMessage}
            </div>
          )
        }

        <div class="mt-4 rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-xl">
          <h1
            class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent"
          >
            {project.name}
          </h1>
          <p class="text-sm text-blue-100/60">
            Created {dateFormatter.format(new Date(project.created_at))} · Updated {
              dateFormatter.format(new Date(project.updated_at))
            }
          </p>

          <section class="mt-8 border-t border-white/10 pt-8">
            <h2 class="text-lg font-medium text-white">Climate</h2>
            <p class="mt-1 text-sm text-blue-100/60">
              Polish winter climate zone and external design temperature for heat load calculations.
            </p>

            <form method="POST" action={`/api/projects/${project.id}/climate`} class="mt-5 space-y-4">
              <div>
                <label for="climate_zone" class="mb-1 block text-sm text-blue-100/80">Climate zone</label>
                <select
                  id="climate_zone"
                  name="climate_zone"
                  class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
                >
                  {
                    CLIMATE_ZONES.map((zone) => (
                      <option value={zone.id} selected={zone.id === selectedZone} class="bg-slate-900 text-white">
                        {zone.label} (default {zone.defaultTempC} °C)
                      </option>
                    ))
                  }
                </select>
              </div>

              <div>
                <label for="external_design_temp_c" class="mb-1 block text-sm text-blue-100/80">
                  External design temperature (°C)
                </label>
                <input
                  type="number"
                  id="external_design_temp_c"
                  name="external_design_temp_c"
                  step="0.1"
                  min="-30"
                  max="-10"
                  value={tempValue}
                  class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
                />
                <p class="mt-1 text-xs text-blue-100/50">
                  Zone change pre-fills the default temperature unless you edit this field manually.
                </p>
              </div>

              <div>
                <label for="storey_height_m" class="mb-1 block text-sm text-blue-100/80"> Storey height (m) </label>
                <input
                  type="number"
                  id="storey_height_m"
                  name="storey_height_m"
                  step="0.1"
                  min="2"
                  max="4"
                  value={storeyHeightValue}
                  class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
                />
                <p class="mt-1 text-xs text-blue-100/50">
                  Floor-to-ceiling height for wall areas and ventilation volume in OZC calculations.
                </p>
              </div>

              <button
                type="submit"
                class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
              >
                Save climate settings
              </button>
            </form>
          </section>

          <section class="mt-8 border-t border-white/10 pt-8">
            <h2 class="text-lg font-medium text-white">Assemblies</h2>
            {
              hasClimate ? (
                <>
                  <p class="mt-1 text-sm text-blue-100/60">
                    Project-scoped building assemblies with layered materials and thermal preview.
                  </p>
                  <div class="mt-5">
                    <AssemblyCatalog
                      client:load
                      projectId={project.id}
                      assemblies={assemblies}
                      categories={ASSEMBLY_CATEGORIES}
                    />
                  </div>
                </>
              ) : (
                <p class="mt-3 rounded-lg border border-amber-400/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-100">
                  Save climate settings above before managing assemblies.
                </p>
              )
            }
          </section>

          <section class="mt-8 border-t border-white/10 pt-8">
            <h2 class="text-lg font-medium text-white">Floor plan</h2>
            <p class="mt-1 text-sm text-blue-100/60">
              One PDF floor plan per project (max 50 MiB). Used as the basis for drawing and heat calculations.
            </p>

            {
              hasFloorPlan ? (
                <div class="mt-5 space-y-4">
                  <dl class="rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm">
                    <div class="flex flex-wrap gap-x-6 gap-y-2">
                      <div>
                        <dt class="text-blue-100/50">File</dt>
                        <dd class="text-white">{project.floor_plan_filename ?? "floor-plan.pdf"}</dd>
                      </div>
                      {project.floor_plan_uploaded_at && (
                        <div>
                          <dt class="text-blue-100/50">Uploaded</dt>
                          <dd class="text-white">{dateFormatter.format(new Date(project.floor_plan_uploaded_at))}</dd>
                        </div>
                      )}
                    </div>
                  </dl>

                  <div class="flex flex-wrap gap-3">
                    <a
                      href={floorPlanApiUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
                    >
                      Open floor plan
                    </a>
                    <form
                      method="POST"
                      action={floorPlanApiUrl}
                      class="inline"
                      onsubmit="return window.confirm('Remove this floor plan?')"
                    >
                      <input type="hidden" name="_action" value="delete" />
                      <button
                        type="submit"
                        class="rounded-lg border border-red-400/40 bg-red-500/10 px-4 py-2 text-sm font-medium text-red-200 transition-colors hover:bg-red-500/20"
                      >
                        Remove floor plan
                      </button>
                    </form>
                  </div>

                  <form method="POST" action={floorPlanApiUrl} enctype="multipart/form-data" class="space-y-3">
                    <div>
                      <label for="floor_plan_file_replace" class="mb-1 block text-sm text-blue-100/80">
                        Replace with another PDF
                      </label>
                      <input
                        type="file"
                        id="floor_plan_file_replace"
                        name="floor_plan_file"
                        accept=".pdf,application/pdf"
                        required
                        class="block w-full text-sm text-blue-100/80 file:mr-4 file:rounded-lg file:border-0 file:bg-purple-600 file:px-4 file:py-2 file:text-sm file:font-medium file:text-white hover:file:bg-purple-500"
                      />
                    </div>
                    <button
                      type="submit"
                      class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-white/15"
                    >
                      Upload replacement
                    </button>
                  </form>
                </div>
              ) : (
                <form method="POST" action={floorPlanApiUrl} enctype="multipart/form-data" class="mt-5 space-y-4">
                  <div>
                    <label for="floor_plan_file" class="mb-1 block text-sm text-blue-100/80">
                      PDF file
                    </label>
                    <input
                      type="file"
                      id="floor_plan_file"
                      name="floor_plan_file"
                      accept=".pdf,application/pdf"
                      required
                      class="block w-full text-sm text-blue-100/80 file:mr-4 file:rounded-lg file:border-0 file:bg-purple-600 file:px-4 file:py-2 file:text-sm file:font-medium file:text-white hover:file:bg-purple-500"
                    />
                  </div>
                  <button
                    type="submit"
                    class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
                  >
                    Upload floor plan
                  </button>
                </form>
              )
            }
          </section>

          <section class="mt-8 border-t border-white/10 pt-8">
            <h2 class="text-lg font-medium text-white">Floor plan editor</h2>
            <p class="mt-1 text-sm text-blue-100/60">
              Draw walls on the uploaded PDF, assign assemblies, define rooms, and configure ventilation inputs.
            </p>

            {
              editorReady ? (
                <div class="mt-5">
                  <a
                    href={editorUrl}
                    class="inline-flex rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
                  >
                    Open floor plan editor
                  </a>
                </div>
              ) : hasFloorPlan ? (
                <p class="mt-3 rounded-lg border border-amber-400/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-100">
                  {!hasClimate && assemblies.length === 0
                    ? "Save climate settings and add at least one assembly before opening the editor."
                    : !hasClimate
                      ? "Save climate settings before opening the editor."
                      : "Add at least one assembly before opening the editor."}
                </p>
              ) : (
                <p class="mt-3 rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-blue-100/60">
                  Upload a floor plan PDF above to enable the editor.
                </p>
              )
            }
          </section>

          <section class="mt-8 border-t border-white/10 pt-8">
            <h2 class="text-lg font-medium text-white">Calculation</h2>
            <p class="mt-1 text-sm text-blue-100/60">
              Run OZC heat loss calculations from your floor plan geometry — per-room transmission and ventilation
              losses plus building totals.
            </p>

            {
              editorReady ? (
                <div class="mt-5">
                  <OzcCalculationPanel client:load projectId={project.id} />
                </div>
              ) : hasFloorPlan ? (
                <p class="mt-3 rounded-lg border border-amber-400/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-100">
                  {!hasClimate && assemblies.length === 0
                    ? "Save climate settings and add at least one assembly before running calculations."
                    : !hasClimate
                      ? "Save climate settings before running calculations."
                      : "Add at least one assembly before running calculations."}
                </p>
              ) : (
                <p class="mt-3 rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-blue-100/60">
                  Upload a floor plan PDF above to enable calculations.
                </p>
              )
            }
          </section>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ zoneDefaultsJson }}>
    const zoneDefaults = JSON.parse(zoneDefaultsJson);
    const zoneSelect = document.getElementById("climate_zone");
    const tempInput = document.getElementById("external_design_temp_c");

    if (zoneSelect instanceof HTMLSelectElement && tempInput instanceof HTMLInputElement) {
      let userOverrode = false;
      const initialTemp = Number(tempInput.value);
      const initialDefault = zoneDefaults[zoneSelect.value];

      if (Number.isFinite(initialTemp) && initialTemp !== initialDefault) {
        userOverrode = true;
      }

      tempInput.addEventListener("input", () => {
        userOverrode = true;
      });

      zoneSelect.addEventListener("change", () => {
        if (!userOverrode) {
          const nextDefault = zoneDefaults[zoneSelect.value];
          if (typeof nextDefault === "number") {
            tempInput.value = String(nextDefault);
          }
        }
      });
    }
  </script>
</Layout>
